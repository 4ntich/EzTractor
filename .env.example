# Copie para .env e ajuste. O arquivo .env nunca vai para o git.

# Opcional. Chave da API da Anthropic (https://console.anthropic.com → API Keys), só para o método "claude".
ANTHROPIC_API_KEY=

# Senha para abrir o site. Deixe vazio se o app roda só no seu computador.
EZT_APP_PASSWORD=
# Necessário só se usar senha. Gere com: python -c "import secrets;print(secrets.token_urlsafe(48))"
EZT_JWT_SECRET=troque-este-segredo-por-um-valor-longo-e-aleatorio

# Método padrão de análise (dá para trocar por projeto no site):
#   heuristic = grátis, só sinais | ollama = grátis, IA local | claude = pago
EZT_RANKER=heuristic
EZT_CLAUDE_MODEL=claude-opus-5-5

# IA local (https://ollama.com). Depois de instalar: ollama pull qwen2.5:7b
# PC fraco? use qwen2.5:3b. Ollama no container do compose (--profile ollama)? use http://ollama:11434
EZT_OLLAMA_MODEL=qwen2.5:7b
# EZT_OLLAMA_URL=http://ollama:11434
# faster_whisper | none   (modelos: tiny, base, small, medium, large-v3)
EZT_TRANSCRIBER=faster_whisper
EZT_WHISPER_MODEL=small

# 1920 = 1080x1920 (padrão) | 1280 = 720x1280, renderiza mais rápido
EZT_RENDER_HEIGHT=1920
