# Copie para .env e ajuste.

# Segredo para assinar tokens e URLs de arquivo. Gere com: python -c "import secrets;print(secrets.token_urlsafe(48))"
EZT_JWT_SECRET=troque-este-segredo-por-um-valor-longo-e-aleatorio

# Chave da API da Anthropic para o ranking com IA (sem ela, o EzTractor usa só a heurística).
ANTHROPIC_API_KEY=

# claude | heuristic
EZT_RANKER=claude
# faster_whisper | none   (modelos: tiny, base, small, medium, large-v3)
EZT_TRANSCRIBER=faster_whisper
EZT_WHISPER_MODEL=small

EZT_CORS_ORIGINS=http://localhost:3000
EZT_SIGNUP_BONUS_CREDITS=120
